# claude-pool server configuration.
# Copy to `.env` and fill in real values. NEVER commit the real file.
# The agent is configured via ~/.claude-pool/config.yaml, not env vars.

# ---- Required ----

# Shared bearer secret. Every HTTP route (including /health) requires
# `Authorization: Bearer <AUTH_SECRET>`. All agents must be configured
# with the same value in their config.yaml (`server.secret`).
# Generate with: openssl rand -base64 32
AUTH_SECRET=replace-me

# AES-256-GCM key used to encrypt agent OAuth tokens at rest in SQLite.
# Must be exactly 32 raw bytes, base64-encoded.
# Generate with: openssl rand -base64 32
#
# WARNING: rotating this key makes previously stored tokens unrecoverable.
# On restart with a different key, the server will skip rows it cannot
# decrypt (agents will simply re-register on next heartbeat).
ENCRYPTION_KEY=replace-me

# ---- Optional ----

# HTTP port the server listens on. Default: 3847
# PORT=3847

# Path to the SQLite database file. Default: ./claude-pool.db
# In Docker the image defaults this to /data/claude-pool.db with a volume.
# DB_PATH=./claude-pool.db
